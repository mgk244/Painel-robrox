-- 3. ENGINE ESP & SISTEMAS
local FOVCircle = Drawing.new("Circle"); FOVCircle.Thickness = 1; FOVCircle.Filled = false
local espCache = {}

local function createEsp(plr)
    if plr == LocalPlayer then return end
    local box = Drawing.new("Square"); box.Thickness = 2; box.Filled = false; box.Visible = false
    local line = Drawing.new("Line"); line.Thickness = 1; line.Visible = false
    local health = Drawing.new("Line"); health.Thickness = 2; health.Visible = false
    espCache[plr] = {Box = box, Line = line, Health = health}
end

Players.PlayerAdded:Connect(createEsp)
for _, p in pairs(Players:GetPlayers()) do createEsp(p) end

local function getClosest()
    local t, d = nil, Settings.FovRadius
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character.Humanoid.Health > 0 then
            local pos, vis = Camera:WorldToViewportPoint(p.Character.Head.Position)
            local mag = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
            if vis and mag < d then d = mag; t = p.Character.Head end
        end
    end
    return t
end

-- SILENT AIM
local mt = getrawmetatable(game); local old = mt.__namecall; setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    if Settings.SilentAim and getnamecallmethod() == "FindPartOnRayWithIgnoreList" then
        local t = getClosest()
        if t then return t, t.Position, t.CFrame.LookVector, t.Material end
    end
    return old(self, ...)
end); setreadonly(mt, true)

-- LOOP PRINCIPAL
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart"); local hum = char and char:FindFirstChild("Humanoid")
    FPSLabel.Text = "FPS: " .. math.floor(workspace:GetRealPhysicsFPS())
    
    FOVCircle.Visible = Settings.FovVisible; FOVCircle.Radius = Settings.FovRadius; FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2); FOVCircle.Color = Settings.MainColor

    for plr, obj in pairs(espCache) do
        local c = plr.Character; local h = c and c:FindFirstChild("Head"); local hu = c and c:FindFirstChild("Humanoid")
        if h and hu and hu.Health > 0 then
            local pos, vis = Camera:WorldToViewportPoint(h.Position)
            if vis then
                local sY, sX = 4000/pos.Z, 2500/pos.Z
                obj.Box.Visible = Settings.EspBox; obj.Box.Size = Vector2.new(sX, sY); obj.Box.Position = Vector2.new(pos.X-sX/2, pos.Y-sY/2); obj.Box.Color = Settings.MainColor
                obj.Line.Visible = Settings.EspLine; obj.Line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y); obj.Line.To = Vector2.new(pos.X, pos.Y+sY/2); obj.Line.Color = Settings.MainColor
                obj.Health.Visible = Settings.EspHealth; obj.Health.From = Vector2.new(pos.X-sX/2-5, pos.Y+sY/2); obj.Health.To = Vector2.new(pos.X-sX/2-5, (pos.Y+sY/2)-(sY*(hu.Health/hu.MaxHealth))); obj.Health.Color = Color3.new(0,1,0)
            else obj.Box.Visible = false; obj.Line.Visible = false; obj.Health.Visible = false end
        else obj.Box.Visible = false; obj.Line.Visible = false; obj.Health.Visible = false end
    end

    if hrp then
        -- FIXED SPEED HACK (CFrame Method - Bypasses WalkSpeed Reset)
        if Settings.SpeedEnabled and hum and hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (Settings.WalkSpeed / 50))
        end

        if Settings.Spinbot then hrp.CFrame *= CFrame.Angles(0, math.rad(Settings.SpinSpeed), 0) end
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local tHrp = p.Character.HumanoidRootPart
                if Settings.LoopBring then tHrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -5) end 
                if Settings.Magnetic and (tHrp.Position - hrp.Position).Magnitude < 30 then
                    tHrp.Velocity = (hrp.Position - tHrp.Position).Unit * 70
                end
            end
        end
    end

    local target = getClosest()
    if target and (Settings.Aimlock or Settings.Aimbot) then
        local tCF = CFrame.new(Camera.CFrame.Position, target.Position)
        Camera.CFrame = Settings.Aimlock and tCF or Camera.CFrame:Lerp(tCF, 0.15)
    end

    if hum then
        if Settings.InfJump and hrp and hrp.Velocity.Y < 0 then hrp.Velocity = Vector3.new(hrp.Velocity.X, Settings.FallDelay, hrp.Velocity.Z) end
    end
end)

