local function CreatePage(name)
    local sc = Instance.new("ScrollingFrame", Container)
    sc.Size = UDim2.new(1, 0, 1, 0); sc.BackgroundTransparency = 1; sc.Visible = false; sc.ScrollBarThickness = 0
    Instance.new("UIListLayout", sc).Padding = UDim.new(0, 10)
